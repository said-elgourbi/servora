# Servora local development environment.
#
# Copy this file to `.env` (gitignored) and adjust values as needed.
# `docker compose` reads `.env` automatically from this directory.
# All values below are LOCAL DEVELOPMENT defaults only — never reuse
# these credentials outside a local sandbox.

# --- PostgreSQL service (docker compose) ---
POSTGRES_USER=servora
POSTGRES_PASSWORD=servora
POSTGRES_DB=servora
POSTGRES_PORT=5432

# --- API (NestJS) ---
# Published host port for the API service.
API_PORT=3000
# Database URL used when the API runs ON THE HOST (make api-start, npm scripts).
# Inside docker compose the api service uses its own DATABASE_URL that points
# at the `postgres` service hostname, so this value is only for host runs.
DATABASE_URL=postgres://servora:servora@localhost:5432/servora
# NODE_ENV and LOG_LEVEL are honoured by the API. The compose api service runs
# with NODE_ENV=production and LOG_LEVEL from this file.
LOG_LEVEL=info

# HS256 signing key for authentication access tokens (minimum 32 characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-32-plus-character-secret

# --- Authentication flow limits (`BR-019`, `BR-043`, `BR-045`) ---
# Every value is optional: the defaults below are the limits product ownership approved.
# The same key is also the pepper for the one-time code digests (`ADR-006` D1).
# PASSWORD_RESET_TOKEN_LIFETIME=30m      how long a reset code stays valid
# PASSWORD_RESET_MAX_ATTEMPTS=5          failed verifications per reset code
# SMS_OTP_LIFETIME=10m                   how long an SMS one-time password stays valid
# SMS_OTP_MAX_ATTEMPTS=5                 failed verifications per one-time password
# SMS_OTP_RESEND_COOLDOWN=60s            minimum interval between two OTP requests
# AUTH_RATE_LIMIT_SHORT_WINDOW=15m       short rolling window for authentication attempts
# AUTH_RATE_LIMIT_SHORT_MAX_ATTEMPTS=3   attempts allowed inside that window
# AUTH_RATE_LIMIT_LONG_WINDOW=24h        long rolling window for authentication attempts
# AUTH_RATE_LIMIT_LONG_MAX_ATTEMPTS=10   attempts allowed inside that window

# --- Password-reset delivery (`ADR-006` D3) ---
# `noop` delivers nothing, which is the safe default while no production transport is approved.
# `file` writes messages to PASSWORD_RESET_DELIVERY_DIRECTORY and is refused when
# NODE_ENV=production, because a delivered message contains a one-time code.
PASSWORD_RESET_DELIVERY=noop
PASSWORD_RESET_DELIVERY_DIRECTORY=var/dev-notifications

# --- Email delivery (`BR-043`, `ADR-008`) ---
# `noop` keeps the port resolvable without a provider account and delivers nothing. `resend`
# requires the two credentials below and fails at startup without them; they are never logged.
# `EMAIL_FROM` must be an address on a domain verified in Resend. Select this transport with
# PASSWORD_RESET_DELIVERY=email.
EMAIL_PROVIDER=noop
# Never commit a real key: Resend credentials belong in the gitignored `.env`
# (or a deployment secret store) only — see `dev.md` §5 and `Project.md` §16.
RESEND_API_KEY=
EMAIL_FROM=support@nordsoft.ca

# --- SMS delivery (`BR-019`, `ADR-006` D4) ---
# `noop` keeps the port resolvable without a provider account. `twilio` requires the three
# credentials below and fails at startup without them; they are never logged. `file` writes each
# message to SMS_FILE_DIRECTORY and is refused when NODE_ENV=production, so it is a local
# development and manual-QA sink only.
SMS_PROVIDER=noop
SMS_FILE_DIRECTORY=var/dev-notifications
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# A Messaging Service SID (MG…) or an E.164 number, e.g. +15145550100.
# TWILIO_FROM=

# --- Object storage (MinIO locally, any S3-compatible service later) ---
# Local object storage for development evidence. The application contract is S3, so a
# deployment replaces this service with a provider (Amazon S3, Cloudflare R2, …) and sets the
# `S3_*` values below — never a code change. See
# `docs/decisions/013-object-storage-minio-and-s3.md`.
# These are LOCAL DEVELOPMENT credentials only — never reuse them outside a local sandbox.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=servora
MINIO_ROOT_PASSWORD=servora-minio
# The bucket `make up` provisions for the local stack, and the bucket the application uses once
# the storage adapter lands: one name, so the stack and the application cannot drift.
S3_BUCKET=servora-dev
# Application-side S3 configuration, uncommented by the slice that adds the storage adapter.
# Inside docker compose the endpoint is the service name; host tooling uses the published port
# (`http://localhost:9000`), exactly like `DATABASE_URL` above. `S3_PUBLIC_ENDPOINT` is only
# needed once read URLs are presigned, because a signature is bound to the host it was made for.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=servora
# S3_SECRET_KEY=servora-minio
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# --- Development seed data (`make seed`) ---
# The accounts `make seed` guarantees on a local database. See
# `docs/development/setup.md` §2 for the dataset and the credential policy.
# No password is ever committed: leave a password variable unset (or empty) and
# `make seed` generates one and prints it once.
SEED_ORGANIZATION_NAME=Servora Development
SEED_MANAGER_EMAIL=manager@servora.test
SEED_MANAGER_PASSWORD=
SEED_TECHNICIAN_EMAIL=technician@servora.test
SEED_TECHNICIAN_PASSWORD=
