{
  "name": "@servora/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "ngc --noEmit -p tsconfig.app.json",
    "test:watch": "ng test",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "test:connected": "RUN_CONNECTED_BROWSER=1 npm run test:e2e --prefix ../api -- test/browser-workspace.e2e-spec.ts",
    "test:acceptance": "playwright test --config playwright.acceptance.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@angular/material": "22.2.3",
    "@angular/cdk": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "@servora/shared-types": "file:../packages/shared-types",
    "@servora/shared-config": "file:../packages/shared-config"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "@playwright/test": "1.64.1",
    "eslint": "^10.0.0",
    "angular-eslint": "22.6.0",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11"
  }
}
