<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only capability this slice needs: reaching the Servora API. Device/GPS permissions arrive
         with the field-work features that use them. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Photo evidence is captured by the device's own camera application, through
         `ACTION_IMAGE_CAPTURE`, so Servora needs no camera permission and no camera feature: the
         camera app owns the capture and writes the photo into this app's private storage. The
         hardware is therefore declared optional, so the app installs on a device without one. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />    

    <!-- Reads whether a network is available, so a queued operation can be replayed when one comes
         back (`docs/architecture/offline-first-architecture.md` §6). It is a trigger, not a gate:
         an operation is queued whenever the API is unreachable. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Saving a photo into the device's own gallery needs no permission from Android 10 on, and Servora
      asks for none there. Android 8-9 still guards a write into shared storage with
      `WRITE_EXTERNAL_STORAGE`, so it is declared for those two releases only (`D12`); the technician
      is asked for it when they save a photo, and is told if they decline. Nothing here reads the
      device's media library - a source photo still comes from the device's own picker (`D10`).
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".ServoraApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Servora">

        <!--
          AppCompat persists the language chosen inside the app across restarts; the languages the
          app ships are declared in `@xml/locales_config` so the system per-app language settings
          page offers exactly those (`docs/decisions/007-android-appearance-controls.md`).
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Exposes exactly one directory — the Job photo evidence a capture is written into — so the
          device's camera application can write the photo through a content URI instead of a `file://`
          path (offline standard §9, `res/xml/file_paths.xml`).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!--
      `ACTION_IMAGE_CAPTURE` is resolved through the package manager, and on Android 11+ an
      application that queries another one must declare the intent it looks for (`BR-042`).
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

</manifest>
