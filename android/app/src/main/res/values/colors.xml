    -->

    <!-- Brand steel blue; the launcher mask supplies the icon shape. -->
    <color name="ic_launcher_background">#2B5EA7</color>

    <!-- App canvas (`background` token): cool near-white in light mode. -->
    <color name="window_background">#F1F3F8</color>
</resources>
