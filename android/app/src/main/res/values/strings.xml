    <!--
      Appearance controls in the sign-in top bar (`BR-028`): the app language and the light/dark
      theme. The two-letter codes are shown exactly as designed, so they are never translated;
      the full names are the labels a screen reader announces for them.
    -->
    <string name="appearance_language_english_code" translatable="false">EN</string>
