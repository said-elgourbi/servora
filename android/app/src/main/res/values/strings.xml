    <!--
      The customer row's derived counts. Plurals keep "1 property"/"1 job" correct in English and
      select the French form, where 0 and 1 share "one" (`BR-028`). "Job" follows the `intervention`
      term the rest of the French copy uses.
    -->
    <plurals name="customers_property_count">
        <item quantity="one">%1$d property</item>
        <item quantity="other">%1$d properties</item>
    </plurals>
    <plurals name="customers_job_count">
        <item quantity="one">%1$d job</item>
        <item quantity="other">%1$d jobs</item>
    </plurals>

    <!--
      The filter control's accessible label while a filter is applied: its visible label is the
      count of applied filters, which on its own does not say what the number means (`BR-028`).
    -->
