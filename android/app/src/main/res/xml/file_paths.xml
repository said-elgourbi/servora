<?xml version="1.0" encoding="utf-8"?>
<!--
  The two directories the app's `FileProvider` exposes, and nothing else.

  `job-photos` is the feature's own evidence directory, which the device's camera application writes a
  capture into (BR-015, offline standard §9). `evidence-share` is the app-private cache directory a
  photo is staged in when the technician shares it with another application, so that application is
  granted read access to that one file and to nothing else (`D13`).
-->
<paths>
    <files-path
        name="job-photos"
        path="job-photos/" />
    <cache-path
        name="evidence-share"
        path="evidence-share/" />
</paths>
